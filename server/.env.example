# ===== 后端服务配置示例（与 server/index.js 读取的变量名保持一致） =====

# 备用 API Key（可选）：API Key 现在由前端用户提供（在页面中粘贴输入）
# 此处的 Key 仅作为后端代理模式的备用选项
# LLM_API_KEY=sk-your-api-key-here

# 服务端口
PORT=3001

# 监听地址：127.0.0.1 仅本机可访问；0.0.0.0 对局域网所有设备开放
# 局域网/多设备访问、将来部署到局域网服务器时设为 0.0.0.0
HOST=127.0.0.1

# 管理员令牌（强烈建议局域网部署时设置）：
# 设置后，非本机（回环）的写操作（上传文档、删除文档、用户管理）必须携带匹配的 X-Admin-Token。
# 与前端构建期变量 VITE_ADMIN_TOKEN 保持一致（见下方说明）。
# 留空时仅允许本机(127.0.0.1)写操作，局域网设备无法上传/管理。
# 生成示例：openssl rand -hex 32
ADMIN_TOKEN=

# 允许的前端来源（用逗号分隔多个地址；默认已放行 localhost/127.0.0.1 的 3001/5182）
# CORS 当前为放行所有来源，局域网同源访问一般无需设置；仅当你用独立前端域名时才需要。
# 局域网部署示例：ALLOWED_ORIGINS=http://172.28.1.14:3001
# ALLOWED_ORIGINS=http://172.28.1.14:3001

# =====================================================================
# 前端构建期变量（不是 server/.env！由 Vite 在构建时读取，需放在项目根目录 .env）
# 局域网部署时，把上面 ADMIN_TOKEN 的值在构建时通过 VITE_ADMIN_TOKEN 烧入前端包，
# 这样每台设备打开页面即自动带令牌，无需手动输入。示例：
#   项目根目录/.env 写入：VITE_ADMIN_TOKEN=<与 ADMIN_TOKEN 相同的值>
#   或构建命令前加：VITE_ADMIN_TOKEN=xxx npm run build
# 注意：VITE_ 前缀变量会编入前端 JS，局域网内任何打开页面者都能在源码中看到，
#       故仅适合“可信内网”做基础防护，不能防范有意的局域网内攻击者。
# =====================================================================
