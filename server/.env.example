# ===== 后端服务配置示例（与 server/index.js 读取的变量名保持一致） =====

# 备用 API Key（可选）：API Key 现在由前端用户提供（在页面中粘贴输入）
# 此处的 Key 仅作为后端代理模式的备用选项
# LLM_API_KEY=sk-your-api-key-here

# 服务端口
PORT=3001

# 监听地址：127.0.0.1 仅本机可访问；0.0.0.0 对局域网所有设备开放
# 局域网/多设备访问、将来部署到局域网服务器时设为 0.0.0.0
HOST=127.0.0.1

# 管理员令牌（强烈建议局域网部署时设置）：
# 设置后，非本机（回环）的写操作（上传文档、删除文档、用户管理）必须携带匹配的 X-Admin-Token。
# 与前端构建期变量 VITE_ADMIN_TOKEN 保持一致（见下方说明）。
# 留空时仅允许本机(127.0.0.1)写操作，局域网设备无法上传/管理。
# 生成示例：openssl rand -hex 32
ADMIN_TOKEN=

# 允许的前端来源（用逗号分隔多个地址；默认已放行 localhost/127.0.0.1 的 3001/5182）
# CORS 当前为放行所有来源，局域网同源访问一般无需设置；仅当你用独立前端域名时才需要。
# 局域网部署示例：ALLOWED_ORIGINS=http://172.28.1.14:3001
# ALLOWED_ORIGINS=http://172.28.1.14:3001

# ===== APC / RTO 只读数据源 =====
# 用途：左侧边栏「APC和RTO」页面即时读取只读数据库中记录的过程数据列值，计算过程参数设定值优化建议。
#
# 推荐在页面上配置：进入「APC和RTO」→ 右上角「数据源配置」→ 数据库登录 / SQL 查询语句 / 参数配置，
# 保存即生效（无需重启服务）。配置写在数据目录的 apc.config.json，不入 git，密码不会回传前端。
# 下面这些变量仅作「统一管控 / 兜底」用途，优先级低于页面保存值。
#
# 未配置 HANA_HOST / HANA_USER 时后端自动回退到内置仿真数据源（仅供功能验证），不会报错。
#
# ⚠ 务必使用只读账号（仅 SELECT 权限），不要复用管理员账号：
#   无论 SQL 来自目录文件、页面保存还是试运行草稿，应用层都会强制校验「单条 SELECT / WITH」
#   并限制行数与执行时间；数据库层面的只读授权仍是更根本的一道防线。
#
# HANA_HOST=10.0.0.21          # HANA 地址
# HANA_PORT=30015              # SQL 端口，默认 30015
# HANA_USER=READONLY_APC       # 只读账号
# HANA_PASSWORD=
# HANA_DATABASE=               # MDC 多租户场景下的租户库名（可选）
# HANA_SCHEMA=                 # 默认 schema（可选，取数 SQL 里也可直接写全限定名）
# HANA_USE_TLS=false           # 是否启用 TLS
# HANA_VALIDATE_CERT=true      # TLS 下是否校验服务端证书
# HANA_SSL_CA=                 # 自定义 CA 证书文件路径（可选）
# HANA_MAX_ROWS=2000           # 单次读取行数上限（硬保护，防止一次拉爆内存）
# HANA_STATEMENT_TIMEOUT_MS=15000  # 语句超时，超时即断开连接释放服务端会话
# HANA_USE_LIMIT=1             # 是否自动为查询追加 LIMIT（老版本 HANA 不支持时设 0）
# APC_ENABLED=1                # 设 0 可整体关闭「APC和RTO」功能
# APC_CACHE_TTL_MS=5000        # 后端结果缓存时长，避免前端轮询频繁打库
# APC_RATE_LIMIT=60            # APC 数据接口每分钟每 IP 请求上限
# APC_PROBE_RATE_LIMIT=20      # 配置类接口（测试连接/试运行/读写配置）每分钟每 IP 上限
# APC_CATALOG_FILE=            # 指定参数目录文件；设置后页面上的目录类保存不再生效
# APC_CONFIG_FILE=             # 覆盖运行期配置文件路径（默认 <数据目录>/apc.config.json）
#
# 种子参数目录（表名/列名需按现场库表修改）见 server/apc.catalog.json；
# 页面上改过的配置保存在 <数据目录>/apc.config.json，两者按「页面 > 种子文件」合并。

# =====================================================================
# 前端构建期变量（不是 server/.env！由 Vite 在构建时读取，需放在项目根目录 .env）
# 局域网部署时，把上面 ADMIN_TOKEN 的值在构建时通过 VITE_ADMIN_TOKEN 烧入前端包，
# 这样每台设备打开页面即自动带令牌，无需手动输入。示例：
#   项目根目录/.env 写入：VITE_ADMIN_TOKEN=<与 ADMIN_TOKEN 相同的值>
#   或构建命令前加：VITE_ADMIN_TOKEN=xxx npm run build
# 注意：VITE_ 前缀变量会编入前端 JS，局域网内任何打开页面者都能在源码中看到，
#       故仅适合“可信内网”做基础防护，不能防范有意的局域网内攻击者。
# =====================================================================
