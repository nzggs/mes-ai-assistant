# ===== 后端服务配置（与 server/index.js 读取的变量名保持一致） =====

# 备用 API Key（可选）：当前端用户未在页面配置 Key 时使用。
# 在 https://platform.deepseek.com/ 获取 API Key
# LLM_API_KEY=sk-your-api-key-here

# 服务端口
PORT=3001

# 监听地址：'::' 为 IPv6 通配符（Node 默认双栈），使 localhost(→::1)、127.0.0.1、局域网 IPv4 均可访问。
# 注意：Windows 浏览器会把 localhost 解析为 ::1，若只监听 0.0.0.0 会导致「后端代理不可用」。
# 容器部署时由 Dockerfile / docker-compose 注入 HOST=0.0.0.0 覆盖此值（Docker 默认网络可能无 IPv6）。
# 环境变量优先级高于本文件（dotenv 不会覆盖已存在的 process.env）。
HOST=::

# 管理员令牌：局域网设备写操作（上传/删除文档、用户管理）必须携带此令牌。
# 与前端构建期变量 VITE_ADMIN_TOKEN 保持一致（见项目根目录 .env）。
ADMIN_TOKEN=64f240429544b325e236d983a0725df6c7410c6ba0eebe68480c4117312c53ce

# 允许的前端来源（用逗号分隔多个地址；默认已放行 localhost/127.0.0.1 的 3001/5182）
# CORS 当前为放行所有来源，局域网同源访问一般无需设置。
ALLOWED_ORIGINS=
