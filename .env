# ===== 统一环境配置 =====
# 本文件同时被两处读取，是项目唯一的配置文件：
#   1) Vite 构建（本地 npm run build / build.cjs）：读取 VITE_ 前缀变量
#   2) docker compose：默认自动加载本文件，读取 ADMIN_TOKEN / OLLAMA_BASE 等
#
# 因此 clone 本仓库后无需任何额外配置，直接执行即可：
#   docker compose up -d --build
#
# 注意：非 VITE_ 前缀的变量不会被打包进前端，可安全存放管理令牌。

# ---------------- 管理令牌 ----------------
# 前后端必须一致，否则局域网设备上传/删除文档会 403
# 更换方式：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 注意：同时要改本文件的 VITE_ADMIN_TOKEN 与 ADMIN_TOKEN，两者保持一致
VITE_ADMIN_TOKEN=64f240429544b325e236d983a0725df6c7410c6ba0eebe68480c4117312c53ce
ADMIN_TOKEN=64f240429544b325e236d983a0725df6c7410c6ba0eebe68480c4117312c53ce

# ---------------- 宿主机 Ollama ----------------
# host 网络模式下 127.0.0.1 即宿主机本身，最可靠
#   host 网络   -> http://127.0.0.1:11434（默认，推荐）
#   bridge 网络 -> http://<宿主机IP>:11434 或 http://172.17.0.1:11434
#   注意：bridge 网络下不能填 127.0.0.1（那是容器自己）
OLLAMA_BASE=http://127.0.0.1:11434

# 宿主机需提前拉取：ollama pull deepseek-r1:1.5b
# 并让 Ollama 监听非回环地址（见 DEPLOY-UBUNTU.md）
OLLAMA_MODEL=deepseek-r1:1.5b

# ---------------- APC / RTO 只读数据源 ----------------
# 「APC和RTO」页面即时读取只读数据库中记录的过程数据列值，用于过程参数设定值优化。
#
# ⚠ 推荐在页面上配置：进入「APC和RTO」→ 右上角「数据源配置」，填数据库登录 / SQL 查询语句 /
#    参数配置三个窗口，保存即生效（无需重启、无需重新构建镜像）。配置写在数据卷
#    /data/apc.config.json，不入 git，密码只回传「是否已设置」。
#
# ⚠ 不要把生产库密码写进本文件：本文件被 git 跟踪且仓库是公开的，等于公开凭据。
#    下面这些变量仅作「统一管控 / 兜底」用途，优先级低于页面保存值。
#
# 不配置任何一项时，后端自动使用内置仿真数据源（页面会标注「仿真数据源」），仅供功能验证。
# 详细说明与只读安全边界见 DEPLOY.md 第 3.4 节；种子参数目录见 server/apc.catalog.json。
#
# ⚠ 请使用只读账号（仅授予 SELECT，且只授权所需表/视图），不要复用管理员账号。
# HANA_HOST=10.0.0.21
# HANA_PORT=30015
# HANA_USER=READONLY_APC
# HANA_PASSWORD=
# HANA_DATABASE=            # MDC 多租户场景下的租户库名，可留空
# HANA_SCHEMA=MES           # 供取数 SQL 模板里的 {{schema}} 使用，可留空
# HANA_USE_TLS=false
# HANA_VALIDATE_CERT=true
# HANA_MAX_ROWS=2000        # 单次读取行数上限（硬保护）
# HANA_STATEMENT_TIMEOUT_MS=15000
# APC_ENABLED=1             # 设 0 可整体关闭该功能
# APC_CACHE_TTL_MS=5000     # 结果缓存，避免前端轮询打库
# APC_RATE_LIMIT=60         # 每分钟每 IP 数据接口请求上限
# APC_PROBE_RATE_LIMIT=20   # 每分钟每 IP 配置类接口请求上限
# APC_CATALOG_FILE=         # 指定参数目录文件；设置后页面上的目录类保存不再生效

# ---------------- 可选 ----------------
# 反向代理/非同源部署时才需要，留空则前端使用页面同源地址
VITE_BACKEND_URL=
